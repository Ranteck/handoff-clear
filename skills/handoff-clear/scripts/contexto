#!/usr/bin/env python3
"""Imprime qué porcentaje de la ventana de contexto usa la sesión actual de Claude Code."""
import glob
import json
import os
import sys

# shortcut: ventana fija de 1M y formato del transcript sin documentar; si Claude Code cambia
# el JSONL o el tamaño de la ventana, ajustar esto.
VENTANA = 1_000_000


def main() -> int:
    config = os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude"))
    sesion = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sesion:
        print("contexto: falta CLAUDE_CODE_SESSION_ID; ¿corre dentro de Claude Code?", file=sys.stderr)
        return 1
    rutas = glob.glob(os.path.join(config, "projects", "*", f"{sesion}.jsonl"))
    if not rutas:
        print(f"contexto: no encontré el transcript de la sesión {sesion}", file=sys.stderr)
        return 1
    uso = None
    with open(rutas[0], encoding="utf-8") as f:
        for linea in f:
            try:
                evento = json.loads(linea)
            except json.JSONDecodeError:
                continue  # líneas parciales o ajenas al formato no cuentan
            mensaje = evento.get("message")
            if (evento.get("type") == "assistant" and not evento.get("isSidechain")
                    and isinstance(mensaje, dict) and mensaje.get("usage")):
                uso = mensaje["usage"]
    if uso is None:
        print("contexto: el transcript no tiene mensajes del modelo todavía", file=sys.stderr)
        return 1
    tokens = sum(uso.get(k, 0) for k in
                 ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
    print(f"{round(tokens * 100 / VENTANA)} %")
    return 0


if __name__ == "__main__":
    sys.exit(main())
